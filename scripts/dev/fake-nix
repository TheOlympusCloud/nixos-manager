#!/bin/sh
# Stand-in for nix during development and tests (never in production): answers the
# app's evaluations from fixture files and echoes every other command.
#   NIXMGR_FAKE_FIXTURES  fixture folder (default: internal/core/testdata/fleet)
#   NIXMGR_FAKE_DELAY     seconds to wait per machine, to see progress in the UI
dir=${NIXMGR_FAKE_FIXTURES:-$(dirname "$0")/../../internal/core/testdata/fleet}
# The app calls each expression with { flakeRef = "path:<src>?narHash=…"; host = "<name>"; }.
all=$*
arg() { printf '%s\n' "$all" | sed -n "s/.* $1 = \"\([^\"]*\)\";.*/\1/p"; }
flake=$(arg flakeRef); flake=${flake#path:}; flake=${flake%%\?*}
host=$(arg host)
case "$*" in
  *" hash path "*) echo "sha256-fake" ;;
  *"nixmgr:iso"*)
    # An installer ISO: a megabyte of noise in a folder the out-link points at.
    out=$(printf '%s\n' "$all" | sed -n 's/.* --out-link \([^ ]*\) .*/\1/p')
    echo "building '/nix/store/fake-nixos-minimal-26.05-x86_64-linux.iso.drv'..."
    sleep "${NIXMGR_FAKE_DELAY:-0}"
    iso=$(mktemp -d "${TMPDIR:-/tmp}/fake-iso-XXXXXX")
    mkdir "$iso/iso"
    head -c 1048576 /dev/urandom > "$iso/iso/nixos-minimal-26.05-x86_64-linux.iso"
    ln -s "$iso" "$out" ;;
  *"nixmgr:discover"*)
    # A file named BROKEN in the evaluated tree plays a flake with a syntax error.
    if [ -f "$flake/BROKEN" ]; then
      echo "error: syntax error, unexpected '}' at /nix/store/x-source/flake.nix:3:1" >&2
      exit 1
    fi
    cat "$dir/discover.json" ;;
  *"nixmgr:host"*)
    sleep "${NIXMGR_FAKE_DELAY:-0}"
    if [ -f "$dir/host-$host.json" ]; then
      # As managed.nix would: the version the working copy's managed.nix applies, and
      # its fleet modules (modules/fleet/<name>/managed.json) on or off for this machine.
      python3 -I - "$dir/host-$host.json" "$flake" "$host" <<'PY'
import json, os, re, sys
host = json.load(open(sys.argv[1]))
flake, name = sys.argv[2], sys.argv[3]
def read(p):
    try:
        return json.load(open(os.path.join(flake, p)))
    except (OSError, ValueError):
        return {}
try:
    version = re.search(r"nixosManager\.version = lib\.mkOption \{[^}]*default = (\d+);", open(os.path.join(flake, "modules/managed.nix")).read())
except OSError:
    version = None
if host.get("managedFile") and version:
    host["managedVersion"] = int(version.group(1))
modules = []
folder = os.path.join(flake, "modules/fleet")
if host.get("managedFile") and host.get("managedVersion", 1) >= 7 and os.path.isdir(folder):
    own = host["managedFile"]
    layers = [(own, read(own)), ("modules/managed.json", read("modules/managed.json"))]
    for m in sorted(os.listdir(folder)):
        path = "modules/fleet/%s/managed.json" % m
        if not os.path.isfile(os.path.join(flake, path)):
            continue
        decl = read(path)
        def at(key, default):
            for file, data in layers:
                node = data.get("settings") or {}
                for seg in ("fleet", "modules", m):
                    node = node.get(seg) if isinstance(node, dict) else None
                if isinstance(node, dict) and key in node:
                    return node[key], [file]
            return default, [path]
        enable, files = at("enable", False)
        options = {}
        for o, d in (decl.get("options") or {}).items():
            value, ofiles = at(o, d.get("default"))
            options[o] = {"value": value, "files": ofiles}
        modules.append({"name": m, "enable": enable, "files": files, "options": options})
host["modules"] = modules
print(json.dumps(host))
PY
    else
      printf 'error: infinite recursion encountered\n       at /nix/store/x-source/hosts/%s/default.nix:12:3\n' "$host" >&2
      exit 1
    fi ;;
  *"nixmgr:home"*) cat "$dir/home-$host.json" ;;
  *"nixmgr:values"*)
    # home:<name> is a standalone home, whose managed.json is homes/<name>/managed.json.
    case $host in
      home:*) managed_file="homes/${host#home:}/managed.json" ;;
      *)
        if [ ! -f "$dir/host-$host.json" ]; then
          printf 'error: infinite recursion encountered\n' >&2
          exit 1
        fi
        managed_file="hosts/$host/managed.json" ;;
    esac
    python3 -I - "$dir/values.json" "$host" "$flake" "$all" "$managed_file" <<'PY'
import json, os, re, sys
data = json.load(open(sys.argv[1]))
host, flake, managed_file = sys.argv[2], sys.argv[3], sys.argv[5]
# pathsJSON = "<JSON, as a Nix string>";
quoted = re.search(r' pathsJSON = "((?:[^"\\]|\\.)*)";', sys.argv[4]).group(1)
paths = json.loads(re.sub(r"\\(.)", r"\1", quoted))
# Settings in the host's managed.json win, as modules/managed.nix makes them do, and
# are reported as defined in that file (the module sets _file).
try:
    managed = json.load(open(os.path.join(flake, managed_file))).get("settings") or {}
except (OSError, ValueError):
    managed = {}
out = {}
for path in paths:
    got = dict(data.get(".".join(path), {}).get(host, {"exists": False}))
    node = managed
    for seg in path:
        node = node.get(seg) if isinstance(node, dict) else None
    if node is not None and not isinstance(node, dict):
        got.update(exists=True, value=node, files=[managed_file])
        got.setdefault("type", "unspecified")
    out[json.dumps(path, separators=(",", ":"))] = got
print(json.dumps(out))
PY
    ;;
  *"nixmgr:options"*) cat "$dir/options.json" ;;
  *" search "*) cat "$dir/packages.json" ;;
  *"flake lock"*)
    echo "nix $*"
    all="$*"
    target="${all##*path:}"
    [ -f "$target/flake.lock" ] || cp "$dir/flake.lock" "$target/flake.lock" ;;
  *) echo "nix $*" ;;
esac
