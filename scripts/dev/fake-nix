#!/bin/sh
# Stand-in for nix during development and tests (never in production): answers the
# app's evaluations from fixture files and echoes every other command.
#   NIXMGR_FAKE_FIXTURES  fixture folder (default: internal/core/testdata/fleet)
#   NIXMGR_FAKE_DELAY     seconds to wait per machine, to see progress in the UI
dir=${NIXMGR_FAKE_FIXTURES:-$(dirname "$0")/../../internal/core/testdata/fleet}
# The app calls each expression with { flakeRef = "path:<src>?narHash=…"; host = "<name>"; }.
all=$*
arg() { printf '%s\n' "$all" | sed -n "s/.* $1 = \"\([^\"]*\)\";.*/\1/p"; }
flake=$(arg flakeRef); flake=${flake#path:}; flake=${flake%%\?*}
host=$(arg host)
case "$*" in
  *" hash path "*) echo "sha256-fake" ;;
  *"nixmgr:discover"*)
    # A file named BROKEN in the evaluated tree plays a flake with a syntax error.
    if [ -f "$flake/BROKEN" ]; then
      echo "error: syntax error, unexpected '}' at /nix/store/x-source/flake.nix:3:1" >&2
      exit 1
    fi
    cat "$dir/discover.json" ;;
  *"nixmgr:host"*)
    sleep "${NIXMGR_FAKE_DELAY:-0}"
    if [ -f "$dir/host-$host.json" ]; then
      cat "$dir/host-$host.json"
    else
      printf 'error: infinite recursion encountered\n       at /nix/store/x-source/hosts/%s/default.nix:12:3\n' "$host" >&2
      exit 1
    fi ;;
  *"nixmgr:home"*) cat "$dir/home-$host.json" ;;
  *"nixmgr:values"*)
    if [ ! -f "$dir/host-$host.json" ]; then
      printf 'error: infinite recursion encountered\n' >&2
      exit 1
    fi
    python3 -I - "$dir/values.json" "$host" "$flake" "$all" <<'PY'
import json, os, re, sys
data = json.load(open(sys.argv[1]))
host, flake = sys.argv[2], sys.argv[3]
# pathsJSON = "<JSON, as a Nix string>";
quoted = re.search(r' pathsJSON = "((?:[^"\\]|\\.)*)";', sys.argv[4]).group(1)
paths = json.loads(re.sub(r"\\(.)", r"\1", quoted))
# Settings in the host's managed.json win, as modules/managed.nix makes them do, and
# are reported as defined in that file (the module sets _file).
try:
    managed = json.load(open(os.path.join(flake, "hosts", host, "managed.json"))).get("settings") or {}
except (OSError, ValueError):
    managed = {}
out = {}
for path in paths:
    got = dict(data.get(".".join(path), {}).get(host, {"exists": False}))
    node = managed
    for seg in path:
        node = node.get(seg) if isinstance(node, dict) else None
    if node is not None and not isinstance(node, dict):
        got.update(exists=True, value=node, files=["hosts/%s/managed.json" % host])
        got.setdefault("type", "unspecified")
    out[json.dumps(path, separators=(",", ":"))] = got
print(json.dumps(out))
PY
    ;;
  *"nixmgr:options"*) cat "$dir/options.json" ;;
  *" search "*) cat "$dir/packages.json" ;;
  *"flake lock"*)
    echo "nix $*"
    all="$*"
    target="${all##*path:}"
    [ -f "$target/flake.lock" ] || cp "$dir/flake.lock" "$target/flake.lock" ;;
  *) echo "nix $*" ;;
esac
